{
  "name": "showtail",
  "version": "0.25.0",
  "description": "Show your work: one private, local history of your AI prompts and file changes, without modifying project folders.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "showtail": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "format": "bun x prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/acceptance/**/*.{ts,json}\" \"assets/report/viewer*.{js,css}\"",
    "format:check": "bun x prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/acceptance/**/*.{ts,json}\" \"assets/report/viewer*.{js,css}\"",
    "license:check": "bun run scripts/verify-licenses.ts",
    "verify:matrix": "bun run scripts/verify-changed.ts",
    "verify:integrations": "bun run scripts/verify-changed.ts",
    "build": "bun build --compile ./src/cli.ts --outfile dist/showtail",
    "build:all": "bash scripts/build-all.sh",
    "build:release:non-windows": "bash scripts/build-non-windows.sh",
    "test:acceptance": "bun run scripts/acceptance/run.ts",
    "test:acceptance:live": "bun run scripts/acceptance/run.ts --live",
    "test:acceptance:large": "bun run scripts/acceptance/report-large.ts",
    "test:acceptance:parity": "bun run scripts/acceptance/report-parity-run.ts",
    "typecheck:acceptance": "bun x tsc -p scripts/acceptance/tsconfig.json --noEmit"
  },
  "keywords": [
    "education",
    "provenance",
    "show-your-work",
    "academic-integrity",
    "cli",
    "learning"
  ],
  "dependencies": {
    "@showtail/agent-traces": "workspace:*",
    "commander": "^14.0.0",
    "turbo-stream": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
