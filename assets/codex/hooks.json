{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "showtail hook session-start --tool codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|shell_command|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "showtail hook post-edit --tool codex",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "showtail hook stop --tool codex"
          }
        ]
      }
    ]
  }
}
